generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum taskStatus {
  ACTIVE
  PENDING
  AWAITING_PAYMENT
  COMPLETE
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum MektekStaffRole {
  CS
  TECHNICIAN
}

enum MektekTechnicianRole {
  MECHANIC
  HELPER
  OJT
}

enum StaffDivision {
  OPERATIONS
  CUSTOMER_SERVICE
  TECHNICAL
  LOGISTICS
  FINANCE
  HUMAN_RESOURCES
}

enum LogisticsStaffArea {
  MONITORING_PO
  RECEIVING
}

enum CatalogServiceLinkSource {
  ADMIN_ASSIGN
  SELF_SERVICE
}

enum CatalogCustomerType {
  STANDARD
  B2B
}

enum CatalogProductionChannel {
  POWERTRAIN
  THERMAL
}

enum CatalogWarehouse {
  REAR
  FRONT
}

enum CatalogStockDirection {
  IN
  OUT
}

enum CatalogStockMovementSource {
  MANUAL
  RECEIVING
  OUTBOUND_PO
}

enum LogisticsPurchaseOrderFlow {
  RECEIVING
  OUTBOUND
}

enum LogisticsPurchaseOrderItemSource {
  CATALOG
  MANUAL
}

enum LogisticsPurchaseOrderStatus {
  OPEN
  CLOSED
}

enum MektekVoucherDiscountType {
  FIXED
  PERCENTAGE
}

enum MektekVoucherScope {
  ALL
  CUSTOMER_TYPE
  CUSTOMER
}

enum Language {
  id
  cz
  en
  de
  uk
}

model Users {
  id               String           @id @default(uuid()) @db.Uuid
  v                Int              @default(0) @map("__v")
  account_name     String?
  avatar           String?
  email            String           @unique
  is_account_admin Boolean          @default(false)
  is_admin         Boolean          @default(false)
  mektekRole       MektekStaffRole?
  staffDivision    StaffDivision?
  logisticsStaffArea LogisticsStaffArea?
  created_on       DateTime         @default(now())
  lastLoginAt      DateTime?
  name             String?
  password         String?
  authVersion      Int              @default(0)
  phone            String?
  phoneNormalized  String?          @unique
  username         String?
  userStatus       ActiveStatus     @default(PENDING)
  userLanguage     Language         @default(id)

  tasksComment       tasksComments[]
  crm_accounts_tasks crm_Accounts_Tasks[]
  customerProfile    CatalogCustomer?
  customerSessions   CustomerSession[]
  whatsappTemplates  MektekWhatsAppMessageTemplate[]

  @@index([email])
  @@index([phoneNormalized])
  @@index([userStatus])
  @@index([userLanguage])
  @@index([is_admin])
  @@index([is_account_admin])
  @@index([mektekRole])
  @@index([staffDivision])
  @@index([logisticsStaffArea])
  @@index([created_on])
  @@index([lastLoginAt])
}

model CustomerSession {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @db.Char(64)
  userId         String    @db.Uuid
  rememberDevice Boolean   @default(false)
  userAgent      String?   @db.VarChar(512)
  ipAddress      String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  idleExpiresAt  DateTime
  expiresAt      DateTime
  revokedAt      DateTime?

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idleExpiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuthRateLimit {
  keyHash         String    @id @db.Char(64)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model crm_Accounts_Tasks {
  id            String      @id @default(uuid()) @db.Uuid
  serviceNumber String?     @unique @db.VarChar(32)
  v             Int         @map("__v")
  content       String?
  createdAt     DateTime?   @default(now())
  createdBy     String?     @db.Uuid
  updatedAt     DateTime?   @updatedAt
  updatedBy     String?     @db.Uuid
  dueDateAt     DateTime?   @default(now())
  priority      String
  tags          Json?       @db.JsonB
  title         String
  likes         BigInt?     @default(0)
  user          String?     @db.Uuid
  taskStatus    taskStatus? @default(ACTIVE)

  comments            tasksComments[]
  assigned_user       Users?               @relation(fields: [user], references: [id])
  catalogServiceLinks CatalogServiceLink[]
  mektekPayments      MektekPayment[]

  @@index([user])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([priority])
  @@index([taskStatus])
  @@index([dueDateAt])
  @@index([createdAt])
}

model MektekServiceMonthlySequence {
  monthKey  String   @id @db.VarChar(6)
  lastValue Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model tasksComments {
  id                        String   @id @default(uuid()) @db.Uuid
  v                         Int      @map("__v")
  comment                   String
  createdAt                 DateTime @default(now())
  task                      String   @db.Uuid
  user                      String   @db.Uuid
  assigned_crm_account_task String?  @db.Uuid

  assigned_crm_account_task_task crm_Accounts_Tasks? @relation(fields: [assigned_crm_account_task], references: [id])
  assigned_user                  Users?              @relation(fields: [user], references: [id])

  @@index([task])
  @@index([user])
  @@index([assigned_crm_account_task])
}

model CatalogCustomer {
  id                 String              @id @default(uuid()) @db.Uuid
  username           String
  phone              String
  phoneNormalized    String              @unique
  customerType       CatalogCustomerType @default(STANDARD)
  vehicleName        String?
  vehiclePlateNumber String?
  vehicleFleetNumber String?
  userId             String?             @unique @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user         Users?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceLinks CatalogServiceLink[]
  vehicles     CatalogCustomerVehicle[]
  vouchers     MektekVoucher[]

  @@index([phoneNormalized])
  @@index([customerType])
  @@index([userId])
  @@index([createdAt])
}

model CatalogCustomerVehicle {
  id                    String    @id @default(uuid()) @db.Uuid
  customerId            String    @db.Uuid
  name                  String
  plateNumber           String
  plateNumberNormalized String
  fleetNumber           String?
  isPrimary             Boolean   @default(false)
  lastServiceAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer CatalogCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, plateNumberNormalized])
  @@index([customerId, isPrimary])
  @@index([plateNumberNormalized])
  @@index([lastServiceAt])
}

// One-time WhatsApp OTP used to prove ownership of a phone number before it can be
// bound to an account (customer self-registration) or used to claim a walk-in
// CatalogCustomer's history. One live row per phone (upsert); single-use via
// consumedAt; brute-force-bounded via attempts.
model CustomerPhoneVerification {
  id              String    @id @default(uuid()) @db.Uuid
  phoneNormalized String    @unique
  codeHash        String
  expiresAt       DateTime
  attempts        Int       @default(0)
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
}

model CatalogItem {
  id                String                    @id
  machine           String
  rowNumber         Int
  illustration      String?
  imagePath         String?
  imageData         Bytes?
  imageMimeType     String?
  partNumber        String?
  catalogPartNumber String?
  description       String
  quantity          String?
  previousQuantity  String?
  quantityUpdatedAt DateTime?
  price             Int?
  remark            String?
  productionChannel CatalogProductionChannel?
  rearLocation      String?
  frontLocation     String?
  rearStock         Int                       @default(0)
  frontStock        Int                       @default(0)
  searchText        String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  inventoryMonths CatalogInventoryMonth[]
  stockMovements  CatalogStockMovement[]
  logisticsItems  LogisticsPurchaseOrderItem[]

  @@index([machine])
  @@index([description])
  @@index([quantityUpdatedAt])
  @@index([productionChannel])
}

model CatalogInventoryMonth {
  id                String   @id @default(uuid()) @db.Uuid
  catalogItemId     String
  month             DateTime @db.Date
  openingRearStock  Int      @default(0)
  openingFrontStock Int      @default(0)
  closingRearStock  Int      @default(0)
  closingFrontStock Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item      CatalogItem            @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  movements CatalogStockMovement[]

  @@unique([catalogItemId, month])
  @@index([month])
}

model CatalogStockMovement {
  id               String                     @id @default(uuid()) @db.Uuid
  catalogItemId    String
  inventoryMonthId String                     @db.Uuid
  warehouse        CatalogWarehouse
  direction        CatalogStockDirection
  quantity         Int
  occurredAt       DateTime
  note             String?
  source           CatalogStockMovementSource @default(MANUAL)
  sourceId         String?
  createdBy        String?                    @db.Uuid
  createdAt        DateTime                   @default(now())

  item           CatalogItem           @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  inventoryMonth CatalogInventoryMonth @relation(fields: [inventoryMonthId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([catalogItemId, occurredAt])
  @@index([inventoryMonthId])
}

model CatalogServiceLink {
  id             String                   @id @default(uuid()) @db.Uuid
  customerId     String                   @db.Uuid
  serviceOrderId String                   @db.Uuid
  source         CatalogServiceLinkSource
  token          String?
  createdAt      DateTime                 @default(now())

  customer     CatalogCustomer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceOrder crm_Accounts_Tasks @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@unique([customerId, serviceOrderId])
  @@index([customerId])
  @@index([serviceOrderId])
  @@index([source])
}

model LogisticsPurchaseOrder {
  id                 String                       @id @default(uuid()) @db.Uuid
  poNumber           String
  flow               LogisticsPurchaseOrderFlow   @default(RECEIVING)
  supplierName       String
  userName           String
  projectName        String
  inputDate          DateTime                     @db.Date
  dueDate            DateTime                     @db.Date
  poType             String                       @default("Normal")
  status             LogisticsPurchaseOrderStatus @default(OPEN)
  deliveryNoteNumber String?                      @unique
  deliveryDate       DateTime?                    @db.Date
  notes              String?
  createdBy          String?                      @db.Uuid
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  items LogisticsPurchaseOrderItem[]

  @@unique([flow, poNumber])
  @@index([flow, status, dueDate])
  @@index([supplierName])
  @@index([userName])
  @@index([projectName])
  @@index([updatedAt])
}

model LogisticsPurchaseOrderItem {
  id               String                           @id @default(uuid()) @db.Uuid
  purchaseOrderId  String                           @db.Uuid
  catalogItemId    String?
  source           LogisticsPurchaseOrderItemSource @default(CATALOG)
  position         Int
  partName         String
  partNumber       String?
  orderedQuantity  Int
  receivedQuantity Int                              @default(0)
  warehouse        CatalogWarehouse?
  note             String?
  status           LogisticsPurchaseOrderStatus     @default(OPEN)
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  purchaseOrder LogisticsPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem?           @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  receipts      LogisticsReceipt[]

  @@unique([purchaseOrderId, position])
  @@index([purchaseOrderId, status])
  @@index([catalogItemId])
  @@index([partName])
  @@index([partNumber])
}

model LogisticsPic {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts LogisticsReceipt[]

  @@index([isActive, name])
}

model LogisticsReceipt {
  id                  String           @id @default(uuid()) @db.Uuid
  purchaseOrderItemId String           @db.Uuid
  picId               String           @db.Uuid
  receivingReference  String
  quantity            Int
  warehouse           CatalogWarehouse @default(REAR)
  receivedAt          DateTime         @db.Date
  note                String?
  imageData           Bytes?
  imageMimeType       String?
  imageUpdatedAt      DateTime?
  createdBy           String?          @db.Uuid
  createdAt           DateTime         @default(now())

  purchaseOrderItem LogisticsPurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  pic               LogisticsPic               @relation(fields: [picId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderItemId, receivingReference])
  @@index([purchaseOrderItemId, receivedAt])
  @@index([picId, receivedAt])
  @@index([receivingReference])
}

model MektekPayment {
  id                String    @id @default(uuid()) @db.Uuid
  serviceOrderId    String    @db.Uuid
  midtransOrderId   String    @unique
  grossAmount       Int
  snapToken         String?
  redirectUrl       String?
  paymentType       String?
  transactionStatus String    @default("pending")
  fraudStatus       String?
  rawPayload        Json?     @db.JsonB
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  serviceOrder crm_Accounts_Tasks @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([transactionStatus])
  @@index([createdAt])
}

model MektekVoucher {
  id              String                    @id @default(uuid()) @db.Uuid
  code            String                    @unique
  normalizedCode  String                    @unique
  title           String
  description     String
  minSubtotal     Int                       @default(0)
  discountType    MektekVoucherDiscountType
  discountAmount  Int?
  discountPercent Int?
  maxDiscount     Int?
  scope           MektekVoucherScope        @default(ALL)
  customerType    CatalogCustomerType?
  customerId      String?                   @db.Uuid
  isActive        Boolean                   @default(true)
  startsAt        DateTime?
  expiresAt       DateTime?
  usageLimit      Int?
  usedCount       Int                       @default(0)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  customer CatalogCustomer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([customerType])
  @@index([customerId])
  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
}

model MektekVoucherCodeDictionary {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  entries   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model MektekWhatsAppMessageTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(80)
  body        String   @db.Text
  purpose     String   @db.VarChar(40)
  isActive    Boolean  @default(false)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Users? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([purpose, isActive])
  @@index([createdById])
  @@index([updatedAt])
}

model MektekTechnician {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  role      MektekTechnicianRole
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([name, role])
  @@index([isActive])
  @@index([role])
  @@index([name])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// The paired WhatsApp (Baileys) session. This lives in Postgres rather than on
// disk because serverless instances share no filesystem and keep nothing between
// invocations — the DB is the only thing that survives, so it is the source of
// truth for both "are we linked?" and the credentials themselves.
//
// Exactly one row, `slug = "default"`. `credsCipher` is AES-256-GCM(BufferJSON(creds))
// — it grants full send-as-the-business access, so it is never stored in the clear.
//
// lockOwner/lockedUntil are a compare-and-swap lease, not decoration: two sockets
// on the same credentials make WhatsApp kick one off with 440 connectionReplaced,
// so only one invocation may hold a connection at a time. The lease expires on its
// own so a crashed invocation cannot deadlock sending forever.
model WhatsAppSession {
  id           String    @id @default(uuid()) @db.Uuid
  slug         String    @unique
  credsCipher  String?
  status       String    @default("not_linked")
  sessionPhone String?
  lastError    String?
  lastQrAt     DateTime?
  linkedAt     DateTime?
  lockOwner    String?
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  signalKeys WhatsAppSignalKey[]

  @@index([lockedUntil])
}

// Signal-protocol key material for the session above (pre-keys, sessions, sender
// keys, app-state sync keys). Baileys reads and writes these constantly, so they
// are separate rows rather than one blob: a send touches a handful of keys, and
// rewriting the whole keyspace each time would be both slow and a lost-update race.
//
// Cascades with the session — orphaned key rows would silently corrupt a later
// re-pair.
model WhatsAppSignalKey {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  type      String
  keyId     String
  valCipher String
  updatedAt DateTime @updatedAt

  session WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, type, keyId])
  @@index([sessionId, type])
}
