// The paired WhatsApp (Baileys) session. This lives in Postgres rather than on
// disk because serverless instances share no filesystem and keep nothing between
// invocations — the DB is the only thing that survives, so it is the source of
// truth for both "are we linked?" and the credentials themselves.
//
// Exactly one row, `slug = "default"`. `credsCipher` is AES-256-GCM(BufferJSON(creds))
// — it grants full send-as-the-business access, so it is never stored in the clear.
//
// lockOwner/lockedUntil are a compare-and-swap lease, not decoration: two sockets
// on the same credentials make WhatsApp kick one off with 440 connectionReplaced,
// so only one invocation may hold a connection at a time. The lease expires on its
// own so a crashed invocation cannot deadlock sending forever.
model WhatsAppSession {
  id           String    @id @default(uuid()) @db.Uuid
  slug         String    @unique
  credsCipher  String?
  status       String    @default("not_linked")
  sessionPhone String?
  lastError    String?
  lastQrAt     DateTime?
  linkedAt     DateTime?
  lockOwner    String?
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  signalKeys WhatsAppSignalKey[]

  @@index([lockedUntil])
}

// Signal-protocol key material for the session above (pre-keys, sessions, sender
// keys, app-state sync keys). Baileys reads and writes these constantly, so they
// are separate rows rather than one blob: a send touches a handful of keys, and
// rewriting the whole keyspace each time would be both slow and a lost-update race.
//
// Cascades with the session — orphaned key rows would silently corrupt a later
// re-pair.
model WhatsAppSignalKey {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  type      String
  keyId     String
  valCipher String
  updatedAt DateTime @updatedAt

  session WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, type, keyId])
  @@index([sessionId, type])
}

// One-time email OTP used to prove ownership of an email address before it can be
// bound to an account (customer self-registration) or used for email-channel auth.
// Mirrors CustomerPhoneVerification: one live row per email (upsert), single-use
// via consumedAt, brute-force-bounded via attempts, code stored only as sha256 hash.
model CustomerEmailVerification {
  id              String    @id @default(uuid()) @db.Uuid
  emailNormalized String    @unique
  codeHash        String
  expiresAt       DateTime
  attempts        Int       @default(0)
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
}

// Single-use hashed unsubscribe link token, mirroring PasswordResetToken. Long
// 30-day TTL because links sit in already-delivered inboxes. One row per
// (user, channel) issuance; prior tokens for the same (user, channel) are
// deleted before a new one is issued.
model EmailUnsubscribeToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  channel   String    @db.VarChar(24)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Per-user email preference. Transactional mail (OTP, password reset) is always
// allowed and NOT gated here — this only controls marketing/offers opt-in.
model UserEmailPreference {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @db.Uuid
  marketingOptedInAt  DateTime?
  offersOptedInAt     DateTime?
  marketingOptedOutAt DateTime?
  offersOptedOutAt    DateTime?
  frequencyCaps       Json?     @db.JsonB
  updatedAt           DateTime  @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per WhatsApp send attempt. This exists because there was previously NO
// record of what left the business number — an admin could not answer "how many
// messages did we send yesterday, to whom, and who triggered them", which is the
// first question worth asking after a suspension.
//
// recipientHash mirrors EmailLog's convention (sha256, no plaintext number at
// rest); recipientMasked is a display-only partial for the admin dashboard.
// `category` is what the daily promotional cap counts.
model WhatsAppMessageLog {
  id              String   @id @default(uuid()) @db.Uuid
  recipientHash   String   @db.Char(64)
  recipientMasked String   @db.VarChar(24)
  purpose         String   @db.VarChar(40)
  category        String   @db.VarChar(16) // "transactional" | "promotional"
  status          String   @db.VarChar(24) // "sent" | "failed" | "suppressed"
  error           String?  @db.Text
  // Staff member who triggered it, when a human did. Null for cron/system sends.
  // Intentionally not a relation so log rows survive user deletion.
  sentById        String?  @db.Uuid
  sentAt          DateTime @default(now())

  @@index([sentAt])
  @@index([purpose, sentAt])
  @@index([status, sentAt])
  @@index([category, sentAt])
  @@index([recipientHash])
}

// Opt-out link tokens. Inbound WhatsApp is architecturally impossible in this
// app (the socket is torn down after every send and nothing listens for
// messages.upsert), so "reply STOP" can never work — the opt-out has to be a
// link to a public web page. Single-use and hashed at rest, mirroring
// EmailUnsubscribeToken.
model WhatsAppOptOutToken {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer CatalogCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

// Deliverability audit + abuse forensics. recipientHash is sha256(email) so we
// can look up by recipient without joining PII every time. One row per send.
model EmailLog {
  id            String   @id @default(uuid()) @db.Uuid
  recipientHash String   @db.Char(64)
  userId        String?  @db.Uuid
  purpose       String   @db.VarChar(40)
  status        String   @db.VarChar(24)
  providerId    String?  @db.VarChar(120)
  error         String?  @db.Text
  sentAt        DateTime @default(now())

  @@index([recipientHash])
  @@index([userId])
  @@index([purpose, sentAt])
  @@index([status, sentAt])
}

// Admin-managed marketing/offer email templates. Mirrors
// MektekWhatsAppMessageTemplate: one-active-per-purpose enforced by a partial
// unique index (created in the migration SQL — Prisma can't express it inline).
model MektekEmailTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(80)
  subject     String   @db.VarChar(200)
  body        String   @db.Text
  purpose     String   @db.VarChar(40)
  isActive    Boolean  @default(false)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Users? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([purpose, isActive])
  @@index([createdById])
  @@index([updatedAt])
}

// Disposable/temp email domain blocklist. Seeded at migration time from the
// disposable-email-domains npm package; admins can append/remove entries, and
// the Resend webhook auto-adds domains after repeated bounces.
model BlockedEmailDomain {
  id        String   @id @default(uuid()) @db.Uuid
  domain    String   @unique @db.VarChar(180)
  source    String   @db.VarChar(24)
  createdAt DateTime @default(now())

  @@index([domain])
  @@index([source])
}
