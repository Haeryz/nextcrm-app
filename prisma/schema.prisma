generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum taskStatus {
  ACTIVE
  PENDING
  AWAITING_PAYMENT
  COMPLETE
  CANCELLED
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum MektekStaffRole {
  CS
  TECHNICIAN
}

enum MektekTechnicianRole {
  MECHANIC
  HELPER
  OJT
}

enum StaffDivision {
  OPERATIONS
  CUSTOMER_SERVICE
  TECHNICAL
  LOGISTICS
  FINANCE
  HUMAN_RESOURCES
}

enum LogisticsStaffArea {
  MONITORING_PO
  RECEIVING
}

enum StaffCapability {
  MEKTEK_CUSTOMER_SERVICE
  MEKTEK_CATALOG
  MEKTEK_MONITORING_PO
  MEKTEK_RECEIVING
  MEKTEK_FINANCE
  MEKTEK_ACCOUNTING
}

enum CatalogServiceLinkSource {
  ADMIN_ASSIGN
  SELF_SERVICE
}

enum CatalogCustomerType {
  STANDARD
  B2B
}

enum CatalogProductionChannel {
  POWERTRAIN
  THERMAL
  AC_RUANGAN
}

enum CatalogWarehouse {
  REAR
  FRONT
}

enum CatalogStockDirection {
  IN
  OUT
}

enum CatalogStockMovementSource {
  MANUAL
  RECEIVING
  OUTBOUND_PO
  SERVICE_ORDER
}

enum LogisticsPurchaseOrderFlow {
  RECEIVING
  OUTBOUND
}

enum LogisticsPurchaseOrderItemSource {
  CATALOG
  MANUAL
}

enum LogisticsPurchaseOrderStatus {
  OPEN
  CLOSED
}

enum LogisticsPurchaseOrderMode {
  MANUAL
  CONSIGNMENT
}

enum LogisticsReceivingDeliveryNoteSource {
  SUPPLIER
  MEKTEK
}

enum FinanceSupplyReviewStatus {
  CLEAR
  BLOCKED
  OVERRIDDEN
}

enum FinanceCounterpartyRole {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum FinanceContractType {
  SERVICE
  SPARE_PART
  RENTAL
  CONSIGNMENT
  MIXED
  OTHER
}

enum FinanceContractStatus {
  DRAFT
  ACTIVE
  TERMINATED
}

enum FinanceQuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
}

enum FinanceSourceType {
  SERVICE_ORDER
  OUTBOUND_DISPATCH
  RECEIVING_PO
  NON_PO_EXPENSE
  BACKFILL
}

enum FinanceSourceStatus {
  UNBILLED
  DRAFTED
  BILLED
  CANCELLED
  NEEDS_REVIEW
}

enum FinanceInvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum FinanceSupplierBillStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  PARTIALLY_PAID
  PAID
  VOID
}

enum FinanceCashStatus {
  POSTED
  REVERSED
}

enum FinancePaymentMethod {
  CASH
  BANK_TRANSFER
  MIDTRANS
  VIRTUAL_ACCOUNT
  QRIS
  CREDIT_CARD
  OTHER
}

enum FinanceApprovalAction {
  ISSUE_INVOICE
  POST_SUPPLIER_BILL
  APPROVE_QUOTE
  POST_DISBURSEMENT
  VOID_INVOICE
  VOID_SUPPLIER_BILL
  REVERSE_RECEIPT
  REVERSE_DISBURSEMENT
  OVERRIDE_SUPPLY_CONFLICT
}

enum FinanceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FinanceAttachmentKind {
  SIGNED_CONTRACT
  QUOTE
  INVOICE_SUPPORT
  TAX_INVOICE
  PAYMENT_PROOF
  APPROVAL
  SIGNATURE
  OTHER
}

enum FinanceReminderStatus {
  PENDING
  SENT
  FAILED
}

enum MektekVoucherDiscountType {
  FIXED
  PERCENTAGE
}

enum MektekVoucherScope {
  ALL
  CUSTOMER_TYPE
  CUSTOMER
}

enum Language {
  id
  cz
  en
  de
  uk
}

model Users {
  id                 String              @id @default(uuid()) @db.Uuid
  v                  Int                 @default(0) @map("__v")
  account_name       String?
  avatar             String?
  email              String              @unique
  is_account_admin   Boolean             @default(false)
  is_admin           Boolean             @default(false)
  mektekRole         MektekStaffRole?
  staffDivision      StaffDivision?
  logisticsStaffArea LogisticsStaffArea?
  staffCapabilities  StaffCapability[]   @default([])
  created_on         DateTime            @default(now())
  lastLoginAt        DateTime?
  name               String?
  password           String?
  authVersion        Int                 @default(0)
  phone              String?
  phoneNormalized    String?             @unique
  username           String?
  userStatus         ActiveStatus        @default(PENDING)
  userLanguage       Language            @default(id)

  tasksComment           tasksComments[]
  crm_accounts_tasks     crm_Accounts_Tasks[]
  customerProfile        CatalogCustomer?
  customerSessions       CustomerSession[]
  whatsappTemplates      MektekWhatsAppMessageTemplate[]
  emailPreference        UserEmailPreference?
  emailUnsubscribeTokens EmailUnsubscribeToken[]
  emailTemplates         MektekEmailTemplate[]

  @@index([email])
  @@index([phoneNormalized])
  @@index([userStatus])
  @@index([userLanguage])
  @@index([is_admin])
  @@index([is_account_admin])
  @@index([mektekRole])
  @@index([staffDivision])
  @@index([logisticsStaffArea])
  @@index([created_on])
  @@index([lastLoginAt])
}

model CustomerSession {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @db.Char(64)
  userId         String    @db.Uuid
  rememberDevice Boolean   @default(false)
  userAgent      String?   @db.VarChar(512)
  ipAddress      String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime  @default(now())
  idleExpiresAt  DateTime
  expiresAt      DateTime
  revokedAt      DateTime?

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idleExpiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuthRateLimit {
  keyHash         String    @id @db.Char(64)
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model crm_Accounts_Tasks {
  id            String      @id @default(uuid()) @db.Uuid
  serviceNumber String?     @unique @db.VarChar(32)
  v             Int         @map("__v")
  content       String?
  createdAt     DateTime?   @default(now())
  createdBy     String?     @db.Uuid
  updatedAt     DateTime?   @updatedAt
  updatedBy     String?     @db.Uuid
  dueDateAt     DateTime?   @default(now())
  priority      String
  tags          Json?       @db.JsonB
  title         String
  likes         BigInt?     @default(0)
  user          String?     @db.Uuid
  taskStatus    taskStatus? @default(ACTIVE)

  comments               tasksComments[]
  assigned_user          Users?                  @relation(fields: [user], references: [id])
  catalogServiceLinks    CatalogServiceLink[]
  mektekPayments         MektekPayment[]
  logisticsPurchaseOrder LogisticsPurchaseOrder?

  @@index([user])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([priority])
  @@index([taskStatus])
  @@index([dueDateAt])
  @@index([createdAt])
}

model MektekServiceMonthlySequence {
  monthKey  String   @id @db.VarChar(6)
  lastValue Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model tasksComments {
  id                        String   @id @default(uuid()) @db.Uuid
  v                         Int      @map("__v")
  comment                   String
  createdAt                 DateTime @default(now())
  task                      String   @db.Uuid
  user                      String   @db.Uuid
  assigned_crm_account_task String?  @db.Uuid

  assigned_crm_account_task_task crm_Accounts_Tasks? @relation(fields: [assigned_crm_account_task], references: [id])
  assigned_user                  Users?              @relation(fields: [user], references: [id])

  @@index([task])
  @@index([user])
  @@index([assigned_crm_account_task])
}

model CatalogCustomer {
  id                 String              @id @default(uuid()) @db.Uuid
  customerNumber     String?             @unique @db.VarChar(24)
  username           String
  phone              String
  phoneNormalized    String              @unique
  customerType       CatalogCustomerType @default(STANDARD)
  vehicleName        String?
  vehiclePlateNumber String?
  vehicleFleetNumber String?
  userId             String?             @unique @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // WhatsApp do-not-contact. Lives HERE and not on UserEmailPreference because
  // that model keys off Users.id, and most Mektek customers are walk-ins with
  // userId = null — they would be unprotected by a Users-keyed opt-out.
  // Set either by the customer (opt-out link) or by staff (toggle); `source`
  // records which. Null = never opted out.
  whatsappOptedOutAt     DateTime?
  whatsappOptedOutSource String?   @db.VarChar(16) // "customer" | "staff"

  user           Users?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceLinks   CatalogServiceLink[]
  vehicles       CatalogCustomerVehicle[]
  vouchers       MektekVoucher[]
  waOptOutTokens WhatsAppOptOutToken[]

  @@index([phoneNormalized])
  @@index([customerType])
  @@index([userId])
  @@index([createdAt])
  @@index([whatsappOptedOutAt])
}

model CatalogCustomerVehicle {
  id                    String    @id @default(uuid()) @db.Uuid
  customerId            String    @db.Uuid
  name                  String
  plateNumber           String
  plateNumberNormalized String
  fleetNumber           String?
  isPrimary             Boolean   @default(false)
  lastServiceAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer CatalogCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, plateNumberNormalized])
  @@index([customerId, isPrimary])
  @@index([plateNumberNormalized])
  @@index([lastServiceAt])
}

// One-time WhatsApp OTP used to prove ownership of a phone number before it can be
// bound to an account (customer self-registration) or used to claim a walk-in
// CatalogCustomer's history. One live row per phone (upsert); single-use via
// consumedAt; brute-force-bounded via attempts.
model CustomerPhoneVerification {
  id              String    @id @default(uuid()) @db.Uuid
  phoneNormalized String    @unique
  codeHash        String
  expiresAt       DateTime
  attempts        Int       @default(0)
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
}

model CatalogItem {
  id                String                    @id
  machine           String
  rowNumber         Int
  illustration      String?
  imagePath         String?
  imageData         Bytes?
  imageMimeType     String?
  partNumber        String?
  catalogPartNumber String?
  description       String
  quantity          String?
  previousQuantity  String?
  quantityUpdatedAt DateTime?
  price             Int?
  remark            String?
  productionChannel CatalogProductionChannel?
  rearLocation      String?
  frontLocation     String?
  rearStock         Int                       @default(0)
  frontStock        Int                       @default(0)
  minStock          Int                       @default(0)
  searchText        String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  inventoryMonths  CatalogInventoryMonth[]
  stockMovements   CatalogStockMovement[]
  consignmentSites CatalogConsignmentSite[]
  logisticsItems   LogisticsPurchaseOrderItem[]

  @@index([machine])
  @@index([description])
  @@index([quantityUpdatedAt])
  @@index([productionChannel])
}

model CatalogInventoryMonth {
  id                String   @id @default(uuid()) @db.Uuid
  catalogItemId     String
  month             DateTime @db.Date
  openingRearStock  Int      @default(0)
  openingFrontStock Int      @default(0)
  closingRearStock  Int      @default(0)
  closingFrontStock Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item      CatalogItem            @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  movements CatalogStockMovement[]

  @@unique([catalogItemId, month])
  @@index([month])
}

model CatalogStockMovement {
  id                String                     @id @default(uuid()) @db.Uuid
  catalogItemId     String
  inventoryMonthId  String                     @db.Uuid
  warehouse         CatalogWarehouse
  direction         CatalogStockDirection
  quantity          Int
  occurredAt        DateTime
  note              String?
  counterpartyName  String?
  consignmentSiteId String?                    @db.Uuid
  source            CatalogStockMovementSource @default(MANUAL)
  sourceId          String?
  createdBy         String?                    @db.Uuid
  createdAt         DateTime                   @default(now())

  item            CatalogItem             @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  inventoryMonth  CatalogInventoryMonth   @relation(fields: [inventoryMonthId], references: [id], onDelete: Cascade)
  consignmentSite CatalogConsignmentSite? @relation(fields: [consignmentSiteId], references: [id], onDelete: SetNull)

  @@unique([source, sourceId])
  @@index([catalogItemId, occurredAt])
  @@index([inventoryMonthId])
  @@index([consignmentSiteId])
}

model CatalogConsignmentSite {
  id            String   @id @default(uuid()) @db.Uuid
  catalogItemId String
  siteName      String
  projectKey    String?
  stock         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item      CatalogItem            @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  movements CatalogStockMovement[]

  @@unique([catalogItemId, siteName])
  @@index([catalogItemId])
  @@index([siteName])
  @@index([projectKey])
}

model CatalogServiceLink {
  id             String                   @id @default(uuid()) @db.Uuid
  customerId     String                   @db.Uuid
  serviceOrderId String                   @db.Uuid
  source         CatalogServiceLinkSource
  token          String?
  createdAt      DateTime                 @default(now())

  customer     CatalogCustomer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceOrder crm_Accounts_Tasks @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@unique([customerId, serviceOrderId])
  @@index([customerId])
  @@index([serviceOrderId])
  @@index([source])
}

model LogisticsPurchaseOrder {
  id                               String                                @id @default(uuid()) @db.Uuid
  sourceServiceOrderId             String?                               @unique @db.Uuid
  poNumber                         String
  flow                             LogisticsPurchaseOrderFlow            @default(RECEIVING)
  supplierName                     String
  userName                         String
  projectName                      String
  inputDate                        DateTime                              @db.Date
  dueDate                          DateTime                              @db.Date
  poType                           String                                @default("Normal")
  poMode                           LogisticsPurchaseOrderMode            @default(MANUAL)
  status                           LogisticsPurchaseOrderStatus          @default(OPEN)
  supplyReviewStatus               FinanceSupplyReviewStatus             @default(CLEAR)
  financeCounterpartyId            String?                               @db.Uuid
  financeContractId                String?                               @db.Uuid
  financeQuoteId                   String?                               @db.Uuid
  supplyStartDate                  DateTime?                             @db.Date
  supplyEndDate                    DateTime?                             @db.Date
  deliveryNoteNumber               String?                               @unique
  deliveryDate                     DateTime?                             @db.Date
  deliveryNoteImageData            Bytes?
  deliveryNoteImageMimeType        String?
  deliveryNoteImageUpdatedAt       DateTime?
  supplierInvoiceImageData         Bytes?
  supplierInvoiceImageMimeType     String?
  supplierInvoiceImageUpdatedAt    DateTime?
  mektekDeliveryNoteImageData      Bytes?
  mektekDeliveryNoteImageMimeType  String?
  mektekDeliveryNoteImageUpdatedAt DateTime?
  customerPoImageData              Bytes?
  customerPoImageMimeType          String?
  customerPoImageUpdatedAt         DateTime?
  signedPoImageData                Bytes?
  signedPoImageMimeType            String?
  signedPoImageUpdatedAt           DateTime?
  receivingDeliveryNoteSource      LogisticsReceivingDeliveryNoteSource?
  notes                            String?
  createdBy                        String?                               @db.Uuid
  createdAt                        DateTime                              @default(now())
  updatedAt                        DateTime                              @updatedAt

  items               LogisticsPurchaseOrderItem[]
  financeCounterparty FinanceCounterparty?         @relation(fields: [financeCounterpartyId], references: [id], onDelete: SetNull)
  financeContract     FinanceContract?             @relation(fields: [financeContractId], references: [id], onDelete: SetNull)
  financeQuote        FinanceQuote?                @relation(fields: [financeQuoteId], references: [id], onDelete: SetNull)
  sourceServiceOrder  crm_Accounts_Tasks?          @relation(fields: [sourceServiceOrderId], references: [id], onDelete: Cascade)

  @@unique([flow, poNumber])
  @@index([flow, status, dueDate])
  @@index([supplierName])
  @@index([userName])
  @@index([projectName])
  @@index([poMode, supplyReviewStatus])
  @@index([financeCounterpartyId, supplyStartDate, supplyEndDate])
  @@index([financeContractId])
  @@index([financeQuoteId])
  @@index([updatedAt])
}

model LogisticsPurchaseOrderItem {
  id                    String                           @id @default(uuid()) @db.Uuid
  purchaseOrderId       String                           @db.Uuid
  catalogItemId         String?
  source                LogisticsPurchaseOrderItemSource @default(CATALOG)
  position              Int
  partName              String
  partNumber            String?
  machine               String?
  orderedQuantity       Int
  receivedQuantity      Int                              @default(0)
  warehouse             CatalogWarehouse?
  note                  String?
  status                LogisticsPurchaseOrderStatus     @default(OPEN)
  agreedUnitPrice       Decimal?                         @db.Decimal(18, 2)
  financeContractLineId String?                          @db.Uuid
  financeQuoteLineId    String?                          @db.Uuid
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  purchaseOrder       LogisticsPurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  catalogItem         CatalogItem?               @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  receipts            LogisticsReceipt[]
  financeContractLine FinanceContractLine?       @relation(fields: [financeContractLineId], references: [id], onDelete: SetNull)
  financeQuoteLine    FinanceQuoteLine?          @relation(fields: [financeQuoteLineId], references: [id], onDelete: SetNull)
  supplyAllocation    LogisticsSupplyAllocation?

  @@unique([purchaseOrderId, position])
  @@index([purchaseOrderId, status])
  @@index([catalogItemId])
  @@index([partName])
  @@index([partNumber])
  @@index([financeContractLineId])
  @@index([financeQuoteLineId])
}

model LogisticsPic {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts LogisticsReceipt[]

  @@index([isActive, name])
}

model LogisticsReceipt {
  id                  String           @id @default(uuid()) @db.Uuid
  purchaseOrderItemId String           @db.Uuid
  picId               String           @db.Uuid
  receivingReference  String
  quantity            Int
  warehouse           CatalogWarehouse @default(REAR)
  receivedAt          DateTime         @db.Date
  note                String?
  imageData           Bytes?
  imageMimeType       String?
  imageUpdatedAt      DateTime?
  createdBy           String?          @db.Uuid
  createdAt           DateTime         @default(now())

  purchaseOrderItem LogisticsPurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  pic               LogisticsPic               @relation(fields: [picId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderItemId, receivingReference])
  @@index([purchaseOrderItemId, receivedAt])
  @@index([picId, receivedAt])
  @@index([receivingReference])
}

model MektekPayment {
  id                String    @id @default(uuid()) @db.Uuid
  serviceOrderId    String    @db.Uuid
  midtransOrderId   String    @unique
  grossAmount       Int
  snapToken         String?
  redirectUrl       String?
  paymentType       String?
  transactionStatus String    @default("pending")
  fraudStatus       String?
  rawPayload        Json?     @db.JsonB
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  serviceOrder crm_Accounts_Tasks @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([transactionStatus])
  @@index([createdAt])
}

model FinanceCounterparty {
  id               String                  @id @default(uuid()) @db.Uuid
  demoImportId     String?                 @db.Uuid
  legalName        String
  normalizedName   String                  @unique
  role             FinanceCounterpartyRole
  taxId            String?
  billingAddress   String?
  contactName      String?
  phone            String?
  email            String?
  paymentTermsDays Int?
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  contracts         FinanceContract[]
  quotes            FinanceQuote[]
  billingSources    FinanceBillingSource[]
  invoices          FinanceInvoice[]
  receipts          FinanceReceipt[]
  payableSources    FinancePayableSource[]
  supplierBills     FinanceSupplierBill[]
  disbursements     FinanceDisbursement[]
  purchaseOrders    LogisticsPurchaseOrder[]
  supplyAllocations LogisticsSupplyAllocation[]
  demoImport        FinanceDemoImport?          @relation(fields: [demoImportId], references: [id], onDelete: SetNull)

  @@index([role, isActive])
  @@index([legalName])
  @@index([demoImportId])
}

model PaymentFakturCustomer {
  id              String   @id @default(uuid()) @db.Uuid
  sheetKey        String   @unique
  customerName    String
  position        Int
  taxLabelPercent Decimal  @default(11) @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries PaymentFakturEntry[]

  @@index([position])
  @@index([customerName])
}

model PaymentFakturEntry {
  id                  String    @id @default(uuid()) @db.Uuid
  customerId          String    @db.Uuid
  sourceRow           Int?
  receiptNumber       String?
  invoiceNumber       String
  invoiceDate         DateTime? @db.Date
  purchaseOrderNumber String?
  destinationBank     String?
  deliveryDate        DateTime? @db.Date
  description         String
  subtotal            Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount           Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal          Decimal   @default(0) @db.Decimal(18, 2)
  transferDate        DateTime? @db.Date
  taxInvoiceNumber    String?
  installment1        Decimal   @default(0) @db.Decimal(18, 2)
  installment2        Decimal   @default(0) @db.Decimal(18, 2)
  installment3        Decimal   @default(0) @db.Decimal(18, 2)
  createdBy           String?   @db.Uuid
  updatedBy           String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer PaymentFakturCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([customerId, sourceRow])
  @@index([customerId, invoiceDate])
  @@index([invoiceNumber])
  @@index([transferDate])
  @@index([purchaseOrderNumber])
}

model MektekSupplierDebtEntry {
  id                  String    @id @default(uuid()) @db.Uuid
  sheetKey            String
  sourceRow           Int
  number              String?
  purchaseOrderDate   DateTime? @db.Date
  purchaseOrderNumber String?
  goodsReceiptDate    DateTime? @db.Date
  receivedBy          String?
  deliveryNoteNumber  String?
  invoiceDate         DateTime? @db.Date
  invoiceNumber       String?
  taxInvoiceNumber    String?
  dueDate             DateTime? @db.Date
  partNumber          String?
  description         String
  quantity            Decimal   @default(0) @db.Decimal(18, 3)
  unitPrice           Decimal   @default(0) @db.Decimal(18, 2)
  amount              Decimal   @default(0) @db.Decimal(18, 2)
  ppnAmount           Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal          Decimal   @default(0) @db.Decimal(18, 2)
  partsEntryDate      DateTime? @db.Date
  paymentDate         DateTime? @db.Date
  paymentAmount       Decimal   @default(0) @db.Decimal(18, 2)
  pbkDate             DateTime? @db.Date
  accountCode         String?
  createdBy           String?   @db.Uuid
  updatedBy           String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([sheetKey, sourceRow])
  @@index([sheetKey, invoiceDate])
  @@index([purchaseOrderNumber])
  @@index([deliveryNoteNumber])
  @@index([invoiceNumber])
}

enum MektekSupplierDebtTransactionKind {
  DEPOSIT
  PAYMENT
}

enum MektekSupplierDebtPaymentSource {
  CASH
  DEPOSIT
}

model MektekSupplierDebtTransaction {
  id                    String                            @id @default(uuid()) @db.Uuid
  sheetKey              String
  sourceRow             Int?
  kind                  MektekSupplierDebtTransactionKind
  paymentSource         MektekSupplierDebtPaymentSource?
  amount                Decimal                           @db.Decimal(18, 2)
  transactionDate       DateTime                          @db.Date
  reference             String?
  note                  String?
