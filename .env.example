# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>?schema=public"

# Prototype mode: disable external APIs (AI providers, Resend, MinIO, Inngest, IMAP/SMTP, GitHub API)
NEXTCRM_PROTOTYPE_MODE="false"
DISABLE_EXTERNAL_APIS="false"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"
JWT_SECRET="your-jwt-secret-here"

# Backend-only admin bootstrap: pnpm admin:bootstrap
NEXTCRM_ADMIN_EMAIL="admin@example.com"
NEXTCRM_ADMIN_PASSWORD="replace-with-at-least-12-characters"
NEXTCRM_ADMIN_NAME="NextCRM Admin"

# No-auth mode for local prototypes only. Keep "false" for real environments.
NEXTCRM_DISABLE_AUTH="false"
NEXTCRM_GUEST_USER_ID="00000000-0000-0000-0000-000000000001"
NEXTCRM_GUEST_USER_EMAIL="guest@nextcrm.local"
NEXTCRM_GUEST_USER_NAME="NextCRM Guest"
NEXTCRM_GUEST_USER_LANGUAGE="en"

# Email Service (Resend)
RESEND_API_KEY="your-resend-api-key"

# AI (OpenAI)
OPENAI_API_KEY="your-openai-api-key"

# Firecrawl (contact enrichment)
FIRECRAWL_API_KEY=            # get from https://firecrawl.dev

# Invoice Parsing (Rossum)
ROSSUM_USERNAME="your-rossum-username"
ROSSUM_PASSWORD="your-rossum-password"

# MinIO Object Storage
NEXT_PUBLIC_MINIO_ENDPOINT="https://your-minio-host"
MINIO_ENDPOINT="https://your-minio-host"
MINIO_PORT="9000"
MINIO_BUCKET="your-bucket-name"
MINIO_USE_SSL="true"
MINIO_ACCESS_KEY="your-access-key"
MINIO_SECRET_KEY="your-secret-key"

# SMTP / IMAP (optional, for email client functionality)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"

# Internal cron job endpoints
CRON_SECRET=                    # Secret for internal cron job endpoints

# Email feature + WhatsApp session encryption — generate with: openssl rand -hex 32
# The paired WhatsApp credentials are encrypted at rest with this key. Losing or
# rotating it means the WhatsApp QR must be scanned again.
EMAIL_ENCRYPTION_KEY=your_64_hex_char_key_here

# WhatsApp transport driver. See docs/whatsapp-on-vercel.md
#   baileys (default) — pure WebSocket, no browser. Works on Vercel and locally.
#   wwebjs            — legacy whatsapp-web.js + Puppeteer/Chrome. LOCAL ONLY;
#                       it cannot run on serverless and is refused when VERCEL=1.
# Leave unset unless you specifically need the old Chrome-based path.
WHATSAPP_DRIVER=baileys

# Baileys log level (silent | error | warn | info | debug). Defaults to `silent`:
# Baileys logs at `info`, which floods function logs with protocol chatter on every
# send. Set to `debug` when diagnosing a pairing or delivery problem.
WHATSAPP_LOG_LEVEL=silent

# Sender-wide signup OTP protection. Defaults are intentionally conservative:
# at least 12 seconds between OTP messages and at most 30 per rolling hour bucket.
WHATSAPP_OTP_MIN_INTERVAL_MS=12000
WHATSAPP_OTP_HOURLY_LIMIT=30

# Campaigns — Resend email sending
RESEND_WEBHOOK_SECRET=     # Resend webhook signing secret (HMAC-verifies /api/resend-webhook)
RESEND_FROM_EMAIL=         # Transactional From: e.g. noreply@yourdomain.com (verified in Resend)

# Email Service — OTP / marketing / offers
# Sender-wide email OTP protection. Defaults: 8s spacing, 60 per rolling hour.
EMAIL_OTP_MIN_INTERVAL_MS=8000
EMAIL_OTP_HOURLY_LIMIT=60

# Marketing/offers From address. Separate from transactional so bulk sends can
# use a dedicated subdomain/IP pool. Leave empty until you own a verified domain.
# In production BOTH RESEND_FROM_EMAIL and EMAIL_MARKETING_FROM MUST be set to a
# domain with SPF/DKIM configured in Resend — otherwise sends fail closed.
EMAIL_MARKETING_FROM=      # e.g. marketing@yourdomain.com

# Base URL for unsubscribe links (defaults to NEXT_PUBLIC_APP_URL if unset).
EMAIL_UNSUBSCRIBE_BASE_URL=

# Optional MX-record validation on signup (default off; disposable-domain
# blocklist is the primary defense).
EMAIL_MX_VALIDATION=false

# Midtrans payment gateway (Mektek)
# Sandbox keys start with SB-Mid-server- / SB-Mid-client- (get them at https://dashboard.sandbox.midtrans.com).
# Production keys start with Mid-server- / Mid-client-. Keep MIDTRANS_IS_PRODUCTION=false while testing.
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_MERCHANT_ID=          # e.g. M123456789
MIDTRANS_SERVER_KEY=           # SB-Mid-server-... (sandbox) — server-only secret, never exposed to the client
MIDTRANS_CLIENT_KEY=           # SB-Mid-client-...
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=  # same value as MIDTRANS_CLIENT_KEY — needed by snap.js in the browser
