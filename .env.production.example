# ============================================================
# MektekCRM — Production Environment Variables
# ============================================================
# Copy this file:  cp .env.production.example .env.production
# Run setup:       ./setup.sh
# Start:           docker compose --env-file .env.production up -d --build
# NEVER commit .env.production to version control.
# ============================================================

# ── Public routing (Traefik + Let's Encrypt) ─────────────────
# APP_DOMAIN must resolve to this server, with inbound TCP 80/443 allowed.
APP_DOMAIN=
TRAEFIK_ACME_EMAIL=
TRAEFIK_LOG_LEVEL=INFO
# Change only when joining an existing shared Traefik network.
TRAEFIK_NETWORK=nextcrm-proxy
# deploy-production.sh menggunakan commit Git sebagai tag image. Isi hanya bila
# Anda sengaja ingin menggunakan tag tetap.
APP_IMAGE_TAG=

# ── Supabase PostgreSQL ──────────────────────────────────────
# The database user is fixed to "postgres" inside docker-compose.yml.
# Auto-generated by deploy-production.sh.
POSTGRES_PASSWORD=
POSTGRES_DB=nextcrm

# ── NextAuth ─────────────────────────────────────────────────
# Auto-generated by setup.sh (openssl rand -base64 32)
NEXTAUTH_SECRET=
JWT_SECRET=

# ── Encryption (REQUIRED) ────────────────────────────────────
# Auto-generated by setup.sh (openssl rand -hex 32)
# REQUIRED for WhatsApp: the paired session credentials are encrypted at rest
# with this key. Without it, WhatsApp pairing fails closed. Rotating it forces a
# re-scan of the QR code.
EMAIL_ENCRYPTION_KEY=

# ── Auth mode ────────────────────────────────────────────────
# MUST be false in production. `true` disables the login screen entirely and
# resolves EVERY request to a guest user with isAdmin: true — the whole admin
# surface, all customer data, and all finance data become publicly reachable.
# This is a PRODUCTION example file, so it ships with the safe value.
#
# lib/session.ts refuses to boot if this is `true` in production (unless
# NEXTCRM_ALLOW_NOAUTH_IN_PROD=true overrides it), so a mistake here fails
# closed rather than silently opening the app — but do not rely on that.
NEXTCRM_DISABLE_AUTH=false
# The guest identity below is only used when NEXTCRM_DISABLE_AUTH=true (local
# dev). NEXTCRM_GUEST_USER_EMAIL is the upsert key for that guest row — changing
# it mints a duplicate guest user, so leave it alone.
NEXTCRM_GUEST_USER_ID=00000000-0000-0000-0000-000000000001
NEXTCRM_GUEST_USER_EMAIL=guest@nextcrm.local
NEXTCRM_GUEST_USER_NAME=MektekCRM Guest
NEXTCRM_GUEST_USER_LANGUAGE=id

# External APIs remain enabled in production. Set true only for an intentional
# maintenance window where Resend, Midtrans, and similar integrations must stop.
DISABLE_EXTERNAL_APIS=false

# ── OAuth providers (only needed if NEXTCRM_DISABLE_AUTH=false) ──
GOOGLE_ID=
GOOGLE_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ── AI / Enrichment (optional) ───────────────────────────────
OPENAI_API_KEY=

# ── Midtrans ────────────────────────────────────────────────
# Keep sandbox mode until the complete payment flow has been verified.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# ── Inngest background jobs (optional) ───────────────────────
# Sign up free at https://app.inngest.com — enables embeddings & enrichment
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Email sending via Resend ─────────────────────────────────
RESEND_API_KEY=
# Transactional From address (OTP, password reset). MUST point at a verified
# domain with SPF/DKIM configured in Resend — otherwise sends fail closed.
RESEND_FROM_EMAIL=
# Marketing/offers From address (separate subdomain/IP pool for bulk sends).
# MUST be a verified domain in Resend in production. Leave empty only while
# testing with Resend's on.resend.com onboarding domain (account owner only).
EMAIL_MARKETING_FROM=
# Resend webhook signing secret (HMAC-verifies /api/resend-webhook for bounce
# and complaint events that feed EmailLog + the auto-blocklist).
RESEND_WEBHOOK_SECRET=

# ── Email Service — OTP / marketing / offers rate limiting ───
# Sender-wide email OTP protection. Defaults: 8s spacing, 60 per rolling hour.
EMAIL_OTP_MIN_INTERVAL_MS=8000
EMAIL_OTP_HOURLY_LIMIT=60

# ── Email Service — unsubscribe + validation ────────────────
# Base URL for unsubscribe links (defaults to NEXT_PUBLIC_APP_URL if unset).
EMAIL_UNSUBSCRIBE_BASE_URL=
# Optional MX-record validation on signup (default off; disposable-domain
# blocklist is the primary defense).
EMAIL_MX_VALIDATION=false

# ── IMAP / SMTP email client (optional) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── WhatsApp ────────────────────────────────────────────────
# Baileys stores its encrypted pairing session in PostgreSQL and is the
# production-safe default for this long-running Docker deployment.
WHATSAPP_DRIVER=baileys
WHATSAPP_LOG_LEVEL=silent

# ── Automated PostgreSQL backup ─────────────────────────────
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Optional but strongly recommended off-site Restic repository. Example:
# RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/nextcrm
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# ── Company identity in generated documents ────────────────
MEKTEK_COMPANY_NAME=PT MekTek Tanjung Lestari
MEKTEK_COMPANY_ADDRESS=
MEKTEK_COMPANY_CONTACT=

# ── Misc ─────────────────────────────────────────────────────
# Auto-generated by deploy-production.sh.
CRON_SECRET=
NEXT_PUBLIC_APP_NAME=MektekCRM
NEXT_PUBLIC_APP_V=0.0.3-beta
# Sender-wide signup OTP protection (shared through Postgres across instances).
WHATSAPP_OTP_MIN_INTERVAL_MS=12000
WHATSAPP_OTP_HOURLY_LIMIT=30
