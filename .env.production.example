# ============================================================
# NextCRM — Production Environment Variables
# ============================================================
# Copy this file:  cp .env.production.example .env.production
# Run setup:       ./setup.sh
# Start:           docker compose --env-file .env.production up -d --build
# NEVER commit .env.production to version control.
# ============================================================

# ── Public routing (Traefik + Let's Encrypt) ─────────────────
# APP_DOMAIN must resolve to this server, with inbound TCP 80/443 allowed.
APP_DOMAIN=
TRAEFIK_ACME_EMAIL=
TRAEFIK_LOG_LEVEL=INFO
# Change only when joining an existing shared Traefik network.
TRAEFIK_NETWORK=nextcrm-proxy

# ── Supabase PostgreSQL ──────────────────────────────────────
# The database user is fixed to "postgres" inside docker-compose.yml.
POSTGRES_PASSWORD=           # auto-generated by setup.sh
POSTGRES_DB=nextcrm

# ── NextAuth ─────────────────────────────────────────────────
# Auto-generated by setup.sh (openssl rand -base64 32)
NEXTAUTH_SECRET=
JWT_SECRET=

# ── Encryption (REQUIRED) ────────────────────────────────────
# Auto-generated by setup.sh (openssl rand -hex 32)
# REQUIRED for WhatsApp: the paired session credentials are encrypted at rest
# with this key. Without it, WhatsApp pairing fails closed. Rotating it forces a
# re-scan of the QR code.
EMAIL_ENCRYPTION_KEY=

# ── Auth mode ────────────────────────────────────────────────
# true  = no login screen, everyone runs as guest admin (good for local/internal)
# false = require OAuth login (need GOOGLE_ID/GITHUB_ID below)
NEXTCRM_DISABLE_AUTH=true
NEXTCRM_GUEST_USER_ID=00000000-0000-0000-0000-000000000001
NEXTCRM_GUEST_USER_EMAIL=guest@nextcrm.local
NEXTCRM_GUEST_USER_NAME=NextCRM Guest
NEXTCRM_GUEST_USER_LANGUAGE=en

# ── OAuth providers (only needed if NEXTCRM_DISABLE_AUTH=false) ──
GOOGLE_ID=
GOOGLE_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ── AI / Enrichment (optional) ───────────────────────────────
OPENAI_API_KEY=

# ── Inngest background jobs (optional) ───────────────────────
# Sign up free at https://app.inngest.com — enables embeddings & enrichment
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Email sending via Resend (optional) ──────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── IMAP / SMTP email client (optional) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Misc ─────────────────────────────────────────────────────
CRON_SECRET=                 # auto-generated by setup.sh
NEXT_PUBLIC_APP_NAME=NextCRM
NEXT_PUBLIC_APP_V=0.0.3-beta
# Sender-wide signup OTP protection (shared through Postgres across instances).
WHATSAPP_OTP_MIN_INTERVAL_MS=12000
WHATSAPP_OTP_HOURLY_LIMIT=30
