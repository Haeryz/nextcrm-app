# Jadwal ini mempertahankan jadwal UTC yang sebelumnya digunakan Vercel Cron.
0 2 * * 1 /usr/local/bin/run-cron /api/cron/mektek-weekly-reminders
0 2 * * * /usr/local/bin/run-cron /api/cron/mektek-finance-reminders
0 3 * * 1 /usr/local/bin/run-cron /api/cron/mektek-marketing-send
0 3 * * 5 /usr/local/bin/run-cron /api/cron/mektek-offers-send
